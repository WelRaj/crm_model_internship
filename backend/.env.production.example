SECRET_KEY=replace-with-a-strong-random-secret-key-at-least-50-characters
DEBUG=False
ALLOWED_HOSTS=api.yourdomain.com,your-server-ip
CSRF_TRUSTED_ORIGINS=https://api.yourdomain.com,https://yourdomain.com
TIME_ZONE=Asia/Kolkata

MYSQL_DATABASE=crmproduct
MYSQL_USER=crmproduct_user
MYSQL_PASSWORD=replace-with-strong-database-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
PASSWORD_RESET_OTP_MINUTES=10

CORS_ALLOWED_ORIGINS=https://yourdomain.com

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

CRM_ADMIN_EMAIL=admin@yourdomain.com
CRM_ADMIN_PASSWORD=replace-with-strong-first-admin-password
CRM_ADMIN_MOBILE=9999999999
CRM_ADMIN_FIRST_NAME=CRM
CRM_ADMIN_LAST_NAME=Admin
